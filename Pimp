<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Random Surgery Lecture Generator</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      text-align: center;
      padding: 20px;
      margin: 0;
      background-color: #f9f9f9;
    }

    h1 {
      margin-top: 20px;
      font-size: 28px;
      color: #333;
    }

    .instruction {
      font-size: 16px;
      color: #666;
      margin-bottom: 15px;
    }

    .control-buttons {
      margin-bottom: 20px;
      display: flex;
      justify-content: center;
      gap: 10px;
    }

    .control-buttons button {
      padding: 8px 20px;
      font-size: 14px;
      background-color: #546e7a;
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    .control-buttons button:hover {
      background-color: #37474f;
    }

    .checkbox-container {
      display: flex;
      justify-content: center;
      margin-bottom: 20px;
    }

    .checkbox-grid {
      display: grid;
      grid-template-columns: repeat(3, 200px);
      gap: 15px;
      padding: 20px;
      background-color: white;
      border-radius: 10px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    .checkbox-item {
      text-align: left;
      display: flex;
      align-items: center;
    }

    .checkbox-item label {
      font-size: 16px;
      cursor: pointer;
      display: flex;
      align-items: center;
      width: 100%;
    }

    .checkbox-item label:hover {
      color: #00796b;
    }

    input[type="checkbox"] {
      margin-right: 8px;
      cursor: pointer;
      width: 16px;
      height: 16px;
    }

    .generate-button {
      margin-top: 30px;
      padding: 12px 35px;
      font-size: 18px;
      background-color: #00796b;
      color: white;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: background-color 0.3s;
    }

    .generate-button:hover {
      background-color: #004d40;
    }

    .generate-button:active {
      transform: scale(0.98);
    }

    #result {
      margin-top: 30px;
      padding: 25px;
      min-height: 60px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .lecture-code {
      font-size: 32px;
      font-weight: bold;
      color: #00796b;
      margin-bottom: 15px;
      padding: 10px 20px;
      background-color: #e0f7fa;
      border-radius: 10px;
      display: inline-block;
    }

    .lecture-title {
      font-size: 20px;
      color: #333;
      max-width: 800px;
      line-height: 1.5;
      padding: 15px;
      background-color: #fff;
      border-left: 4px solid #00796b;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
      text-align: left;
    }

    .no-result {
      color: #999;
      font-style: italic;
      font-size: 18px;
    }

    @media (max-width: 768px) {
      .checkbox-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      
      .lecture-title {
        font-size: 18px;
      }
    }

    @media (max-width: 480px) {
      .checkbox-grid {
        grid-template-columns: 1fr;
      }
      
      .lecture-code {
        font-size: 28px;
      }
    }
  </style>
</head>
