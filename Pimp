    function selectAll() {
      const checkboxes = document.querySelectorAll('input[name="block"]');
      checkboxes.forEach(cb => cb.checked = true);
    }

    function deselectAll() {
      const checkboxes = document.querySelectorAll('input[name="block"]');
      checkboxes.forEach(cb => cb.checked = false);
    }

    function generateLecture() {
      const checkboxes = document.querySelectorAll('input[name="block"]:checked');
      if (checkboxes.length === 0) {
        alert("Please select at least one block.");
        return;
      }

      const selectedBlocks = Array.from(checkboxes).map(cb => cb.value);
      const filteredLectures = lectures.filter(lec => selectedBlocks.includes(lec.block));

      if (filteredLectures.length === 0) {
        alert("No lectures found for selected blocks.");
        return;
      }

      const randomLecture = filteredLectures[Math.floor(Math.random() * filteredLectures.length)];

      document.getElementById("result").innerHTML = `
        <div class="lecture-code">${randomLecture.code}</div>
        <div class="lecture-title">${randomLecture.title}</div>
      `;
